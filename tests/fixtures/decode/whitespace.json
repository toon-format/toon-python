{
  "version": "4.0",
  "category": "decode",
  "description": "Whitespace tolerance in decoding – surrounding spaces around delimiters and values",
  "tests": [
    {
      "name": "tolerates spaces around comma, pipe, and tab delimiters in inline arrays",
      "input": "comma[3]: a , b , c\npipe[3|]: a | b | c\ntab[3\t]: a \t b \t c",
      "expected": {
        "comma": ["a", "b", "c"],
        "pipe": ["a", "b", "c"],
        "tab": ["a", "b", "c"]
      },
      "specSection": "12"
    },
    {
      "name": "tolerates leading and trailing spaces in tabular row values",
      "input": "items[2]{id,name}:\n  1 , Ada \n  2 , Bob ",
      "expected": {
        "items": [
          { "id": 1, "name": "Ada" },
          { "id": 2, "name": "Bob" }
        ]
      },
      "specSection": "12"
    },
    {
      "name": "tolerates spaces around delimiters with quoted values",
      "input": "items[3]: \"a\" , \"b\" , \"c\"",
      "expected": {
        "items": ["a", "b", "c"]
      },
      "specSection": "12"
    },
    {
      "name": "parses empty tokens as empty string",
      "input": "items[4]: a,,c,",
      "expected": {
        "items": ["a", "", "c", ""]
      },
      "specSection": "11.2"
    },
    {
      "name": "keeps a leading NBSP and a trailing tab in unquoted values",
      "input": "a: \u00a0v\nb: v\t",
      "expected": {
        "a": "\u00a0v",
        "b": "v\t"
      },
      "specSection": "12",
      "note": "Token trimming removes U+0020 only; NBSP and tab are part of the token"
    },
    {
      "name": "preserves NBSP and tab around inline array tokens",
      "input": "items[2]: \u00a0a\u00a0,\tb",
      "expected": {
        "items": ["\u00a0a\u00a0", "\tb"]
      },
      "specSection": "12",
      "note": "Token trimming removes U+0020 only; a host trim() that also strips NBSP or tab corrupts this round-trip"
    },
    {
      "name": "keeps an NBSP or a tab around a key or field name",
      "input": "a\u00a0: 1\nb\t: 2\nt[1]{\u00a0c}:\n  3",
      "expected": {
        "a\u00a0": 1,
        "b\t": 2,
        "t": [{ "\u00a0c": 3 }]
      },
      "specSection": "12",
      "minSpecVersion": "4.1"
    },
    {
      "name": "decodes CRLF line terminators",
      "input": "a: 1\r\nb: 2\r\n",
      "expected": { "a": 1, "b": 2 },
      "specSection": "12"
    },
    {
      "name": "decodes tabular rows with CRLF line terminators",
      "input": "items[2]{a,b}:\r\n  1,2\r\n  3,4\r\n",
      "expected": { "items": [{ "a": 1, "b": 2 }, { "a": 3, "b": 4 }] },
      "specSection": "12"
    },
    {
      "name": "treats a carriage-return-only line as blank",
      "input": "a: 1\n\r\nb: 2",
      "expected": { "a": 1, "b": 2 },
      "specSection": "12"
    },
    {
      "name": "strips a trailing carriage return at end of input",
      "input": "a: 1\r",
      "expected": { "a": 1 },
      "specSection": "12"
    },
    {
      "name": "strips a leading byte-order mark",
      "input": "\ufeffa: 1",
      "expected": {
        "a": 1
      },
      "specSection": "12",
      "minSpecVersion": "4.1"
    },
    {
      "name": "treats a hyphen followed by trailing spaces as the bare marker",
      "input": "a[1]: \n  - ",
      "expected": {
        "a": [
          {}
        ]
      },
      "specSection": "12",
      "note": "Trailing spaces are stripped before line classification",
      "minSpecVersion": "4.1"
    },
    {
      "name": "tolerates extra spaces after a list-item hyphen and keeps an NBSP after them",
      "input": "items[3]:\n  -  \u00a0a\n  -   [2]: 1,2\n  -  k[1]: v",
      "expected": {
        "items": [
          "\u00a0a",
          [
            1,
            2
          ],
          {
            "k": [
              "v"
            ]
          }
        ]
      },
      "specSection": "5.2",
      "minSpecVersion": "4.4"
    },
    {
      "name": "throws on a tab after a list-item hyphen",
      "input": "items[1]:\n  -\tx",
      "expected": null,
      "shouldError": true,
      "specSection": "5.2"
    },
    {
      "name": "keeps a second carriage return before CRLF as content",
      "input": "a: x\r\r\nb: 1",
      "expected": {
        "a": "x\r",
        "b": 1
      },
      "specSection": "12"
    },
    {
      "name": "keeps a byte-order mark after the document start as content",
      "input": "\ufeff\ufeffa: 1\n\ufeffb: 2",
      "expected": {
        "\ufeffa": 1,
        "\ufeffb": 2
      },
      "specSection": "12",
      "minSpecVersion": "4.1"
    },
    {
      "name": "removes a byte-order mark before a comment line",
      "input": "\ufeff# c\na: 1",
      "expected": {
        "a": 1
      },
      "specSection": "12",
      "minSpecVersion": "4.1"
    }
  ]
}
