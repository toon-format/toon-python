{
  "version": "4.0",
  "category": "decode",
  "description": "Nested and mixed array decoding – list form, arrays of arrays, root arrays, mixed types",
  "tests": [
    {
      "name": "parses list arrays for non-uniform objects",
      "input": "items[2]:\n  - id: 1\n    name: First\n  - id: 2\n    name: Second\n    extra: true",
      "expected": {
        "items": [
          { "id": 1, "name": "First" },
          { "id": 2, "name": "Second", "extra": true }
        ]
      },
      "specSection": "9.4"
    },
    {
      "name": "parses list arrays with empty items",
      "input": "items[3]:\n  - first\n  - second\n  -",
      "expected": {
        "items": ["first", "second", {}]
      },
      "specSection": "9.4"
    },
    {
      "name": "parses list arrays with deeply nested objects",
      "input": "items[2]:\n  - properties:\n      state:\n        type: string\n  - id: 2",
      "expected": {
        "items": [
          {
            "properties": {
              "state": {
                "type": "string"
              }
            }
          },
          {
            "id": 2
          }
        ]
      },
      "specSection": "10"
    },
    {
      "name": "parses list arrays containing objects with nested properties",
      "input": "items[1]:\n  - id: 1\n    nested:\n      x: 1",
      "expected": {
        "items": [
          { "id": 1, "nested": { "x": 1 } }
        ]
      },
      "specSection": "9.4"
    },
    {
      "name": "parses list items whose first field is a tabular array, with and without sibling fields",
      "input": "items[2]:\n  - users[2]{id,name}:\n      1,Ada\n      2,Bob\n    status: active\n  - users[2]{id,name}:\n      3,Cy\n      4,Dee",
      "expected": {
        "items": [
          {
            "users": [
              { "id": 1, "name": "Ada" },
              { "id": 2, "name": "Bob" }
            ],
            "status": "active"
          },
          {
            "users": [
              { "id": 3, "name": "Cy" },
              { "id": 4, "name": "Dee" }
            ]
          }
        ]
      },
      "specSection": "10",
      "note": "Canonical encoding: tabular header on hyphen line, rows at depth +2, sibling fields at depth +1"
    },
    {
      "name": "parses a legacy [0] header as a later field of a list-item object",
      "input": "items[1]:\n  - name: Ada\n    data[0]:",
      "expected": {
        "items": [{ "name": "Ada", "data": [] }]
      },
      "specSection": "10"
    },
    {
      "name": "parses a list-form array as the first field of a list-item object",
      "input": "items[1]:\n  - matrix[2]:\n      - [2]: 1,2\n      - [2]: 3,4\n    name: grid",
      "expected": {
        "items": [{ "matrix": [[1, 2], [3, 4]], "name": "grid" }]
      },
      "specSection": "10"
    },
    {
      "name": "parses quoted strings and mixed lengths in nested arrays",
      "input": "pairs[2]:\n  - [2]: a,b\n  - [3]: \"c,d\",\"e:f\",\"true\"",
      "expected": {
        "pairs": [["a", "b"], ["c,d", "e:f", "true"]]
      },
      "specSection": "9.2"
    },
    {
      "name": "parses empty inner arrays",
      "input": "pairs[2]:\n  - [0]:\n  - [0]:",
      "expected": {
        "pairs": [[], []]
      },
      "specSection": "9.2"
    },
    {
      "name": "parses root-level primitive array inline",
      "input": "[5]: x,y,\"true\",true,10",
      "expected": ["x", "y", "true", true, 10],
      "specSection": "9.1"
    },
    {
      "name": "parses root-level array of uniform objects in tabular form",
      "input": "[2]{id}:\n  1\n  2",
      "expected": [{ "id": 1 }, { "id": 2 }],
      "specSection": "9.3"
    },
    {
      "name": "parses root-level array of non-uniform objects in list form",
      "input": "[2]:\n  - id: 1\n  - id: 2\n    name: Ada",
      "expected": [{ "id": 1 }, { "id": 2, "name": "Ada" }],
      "specSection": "9.4"
    },
    {
      "name": "parses root-level array mixing primitive, object, and array of objects in list form",
      "input": "[3]:\n  - summary\n  - id: 1\n    name: Ada\n  - [2]:\n    - id: 2\n    - status: draft",
      "expected": ["summary", { "id": 1, "name": "Ada" }, [{ "id": 2 }, { "status": "draft" }]],
      "specSection": "9.4"
    },
    {
      "name": "parses root-level array of arrays",
      "input": "[2]:\n  - [2]: 1,2\n  - [0]:",
      "expected": [[1, 2], []],
      "specSection": "9.2"
    },
    {
      "name": "parses empty root-level array",
      "input": "[0]:",
      "expected": [],
      "specSection": "9.1"
    },
    {
      "name": "parses complex mixed object with arrays and nested objects",
      "input": "user:\n  id: 123\n  name: Ada\n  tags[2]: reading,gaming\n  active: true\n  prefs[0]:",
      "expected": {
        "user": {
          "id": 123,
          "name": "Ada",
          "tags": ["reading", "gaming"],
          "active": true,
          "prefs": []
        }
      },
      "specSection": "8"
    },
    {
      "name": "parses arrays mixing primitives, objects, and strings in list form",
      "input": "items[3]:\n  - 1\n  - a: 1\n  - text",
      "expected": {
        "items": [1, { "a": 1 }, "text"]
      },
      "specSection": "9.4"
    },
    {
      "name": "accepts bare bracket pair as empty inner array list item",
      "input": "items[2]:\n  - []\n  - [1]: x",
      "expected": {
        "items": [[], ["x"]]
      },
      "specSection": "9.2",
      "note": "Decode-side acceptance mirrors §9.1's key: [] form; encoders still emit - [0]:"
    },
    {
      "name": "keeps every list item when the count mismatches in non-strict mode",
      "input": "a[1]:\n  - 1\n  - 2\nb[3]:\n  - x",
      "expected": {
        "a": [
          1,
          2
        ],
        "b": [
          "x"
        ]
      },
      "options": {
        "strict": false
      },
      "specSection": "14.4",
      "note": "A declared [N] never truncates a scope",
      "minSpecVersion": "4.1"
    },
    {
      "name": "throws on a non-list-item line at item depth",
      "input": "items[2]:\n  - a\n  x: 1",
      "expected": null,
      "shouldError": true,
      "specSection": "9.4",
      "minSpecVersion": "4.1"
    },
    {
      "name": "parses an array of arrays in list-item position",
      "input": "[1]:\n  - [1]:\n    - [1]: 1",
      "expected": [
        [
          [
            1
          ]
        ]
      ],
      "specSection": "9.4"
    },
    {
      "name": "parses an empty object as the first field of a list-item object",
      "input": "items[1]:\n  - a:\n    b: 1",
      "expected": {
        "items": [
          {
            "a": {},
            "b": 1
          }
        ]
      },
      "specSection": "10"
    },
    {
      "name": "parses a tabular array as a later field of a list-item object",
      "input": "items[1]:\n  - id: 1\n    users[2]{id,name}:\n      1,Ada\n      2,Bob",
      "expected": {
        "items": [
          {
            "id": 1,
            "users": [
              {
                "id": 1,
                "name": "Ada"
              },
              {
                "id": 2,
                "name": "Bob"
              }
            ]
          }
        ]
      },
      "specSection": "10"
    },
    {
      "name": "parses quoted list item shaped like an inline array header",
      "input": "xs[1]:\n  - \"[2]: x\"",
      "expected": {
        "xs": [
          "[2]: x"
        ]
      },
      "specSection": "9.4"
    },
    {
      "name": "keeps list items under a legacy [0] header in non-strict mode",
      "input": "a[0]:\n  - x",
      "expected": {
        "a": [
          "x"
        ]
      },
      "options": {
        "strict": false
      },
      "specSection": "14.4",
      "note": "A legacy [0] is a declared length, so its content is decoded (§14.4)",
      "minSpecVersion": "4.1"
    },
    {
      "name": "parses list items shaped like headers without a colon as strings",
      "input": "a[3]:\n  - [2]\n  - a[2]{x,x}\n  - [1,2,3]",
      "expected": {
        "a": [
          "[2]",
          "a[2]{x,x}",
          "[1,2,3]"
        ]
      },
      "specSection": "6",
      "minSpecVersion": "4.2"
    }
  ]
}
