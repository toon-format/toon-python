{
  "version": "4.0",
  "category": "decode",
  "description": "Strict mode indentation validation – non-multiple indentation, tab characters, custom indentSizes",
  "tests": [
    {
      "name": "throws on object field with non-multiple indentation (3 spaces with indentSize 2)",
      "input": "a:\n   b: 1",
      "expected": null,
      "shouldError": true,
      "options": {
        "indentSize": 2,
        "strict": true
      },
      "specSection": "14.2"
    },
    {
      "name": "throws on list item with non-multiple indentation (3 spaces with indentSize 2)",
      "input": "items[2]:\n   - id: 1\n   - id: 2",
      "expected": null,
      "shouldError": true,
      "options": {
        "indentSize": 2,
        "strict": true
      },
      "specSection": "14.2"
    },
    {
      "name": "throws on 2-space indentation with custom indentSize 4",
      "input": "a:\n  b: 1",
      "expected": null,
      "shouldError": true,
      "options": {
        "indentSize": 4,
        "strict": true
      },
      "specSection": "14.2"
    },
    {
      "name": "accepts correct indentation with custom indentSize (4 spaces with indentSize 4)",
      "input": "a:\n    b: 1",
      "expected": {
        "a": {
          "b": 1
        }
      },
      "options": {
        "indentSize": 4,
        "strict": true
      },
      "specSection": "12"
    },
    {
      "name": "throws on tab character used in indentation",
      "input": "a:\n\tb: 1",
      "expected": null,
      "shouldError": true,
      "options": {
        "strict": true
      },
      "specSection": "14.2"
    },
    {
      "name": "throws on mixed tabs and spaces in indentation",
      "input": "a:\n \tb: 1",
      "expected": null,
      "shouldError": true,
      "options": {
        "strict": true
      },
      "specSection": "14.2"
    },
    {
      "name": "throws on tab at start of line",
      "input": "\ta: 1",
      "expected": null,
      "shouldError": true,
      "options": {
        "strict": true
      },
      "specSection": "14.2"
    },
    {
      "name": "accepts tabs in quoted string values",
      "input": "text: \"hello\tworld\"",
      "expected": {
        "text": "hello\tworld"
      },
      "options": {
        "strict": true
      },
      "specSection": "12"
    },
    {
      "name": "accepts tabs in quoted keys",
      "input": "\"key\ttab\": value",
      "expected": {
        "key\ttab": "value"
      },
      "options": {
        "strict": true
      },
      "specSection": "12"
    },
    {
      "name": "accepts tabs in quoted array elements",
      "input": "items[2]: \"a\tb\",\"c\td\"",
      "expected": {
        "items": ["a\tb", "c\td"]
      },
      "options": {
        "strict": true
      },
      "specSection": "12"
    },
    {
      "name": "accepts non-multiple indentation at nested depths when strict=false",
      "input": "a:\n   b:\n     c: 1\n  d: 2",
      "expected": {
        "a": {
          "b": { "c": 1 },
          "d": 2
        }
      },
      "options": {
        "indentSize": 2,
        "strict": false
      },
      "specSection": "12"
    },
    {
      "name": "throws on depth jump of more than one level",
      "input": "a:\n    b: 1",
      "expected": null,
      "shouldError": true,
      "specSection": "8",
      "note": "Four leading spaces are a multiple of indentSize 2, but depth 2 directly under depth 0 skips a level"
    },
    {
      "name": "throws on depth jump inside a nested object",
      "input": "a:\n  b:\n      c: 1",
      "expected": null,
      "shouldError": true,
      "specSection": "8"
    },
    {
      "name": "throws on an over-indented line under a primitive list item",
      "input": "items[2]:\n  - a\n    b: 1\n  - c",
      "expected": null,
      "shouldError": true,
      "specSection": "8"
    },
    {
      "name": "throws on a line indented one level under a primitive field",
      "input": "a: 1\n  b: 2",
      "expected": null,
      "shouldError": true,
      "specSection": "8",
      "note": "Even a single extra level is over-indentation when the preceding line did not open a scope"
    },
    {
      "name": "throws on over-indented line inside a nested object",
      "input": "a:\n  b: 1\n      c: 2",
      "expected": null,
      "shouldError": true,
      "specSection": "8",
      "note": "The depth-3 line follows a primitive field at depth 1; it belongs to no scope"
    },
    {
      "name": "throws on over-indented line after tabular rows",
      "input": "u[1]{a}:\n  1\n    junk: 9",
      "expected": null,
      "shouldError": true,
      "specSection": "8"
    },
    {
      "name": "throws on orphan scalar line under a primitive field in non-strict mode",
      "input": "a: 1\n  hello",
      "expected": null,
      "shouldError": true,
      "options": {
        "strict": false
      },
      "specSection": "8",
      "note": "The non-strict skip for over-indented lines excludes scalar lines (§5.2)",
      "minSpecVersion": "4.1"
    },
    {
      "name": "throws on an indented first line",
      "input": "  a: 1",
      "expected": null,
      "shouldError": true,
      "specSection": "8",
      "minSpecVersion": "4.2"
    },
    {
      "name": "throws on a hyphen-leading bare token under a primitive field in non-strict mode",
      "input": "a: 1\n  - x",
      "expected": null,
      "shouldError": true,
      "options": {
        "strict": false
      },
      "specSection": "5.2",
      "minSpecVersion": "4.2"
    },
    {
      "name": "adopts the depth of a jumped first line in non-strict mode",
      "input": "a:\n    b: 1\n  c: 2\n    d: 3",
      "expected": {
        "a": {
          "b": 1,
          "d": 3
        }
      },
      "options": {
        "strict": false
      },
      "specSection": "8",
      "minSpecVersion": "4.2"
    },
    {
      "name": "skips a line above the adopted entry depth in non-strict mode",
      "input": "m[1:]{a}:\n    x: 1\n  y: 2",
      "expected": {
        "m": {
          "x": {
            "a": 1
          }
        }
      },
      "options": {
        "strict": false
      },
      "specSection": "8",
      "minSpecVersion": "4.2"
    },
    {
      "name": "skips a line above the adopted row depth in non-strict mode",
      "input": "rows[2]{a}:\n    1\n  x: 9\n    2",
      "expected": {
        "rows": [
          {
            "a": 1
          },
          {
            "a": 2
          }
        ]
      },
      "options": {
        "strict": false
      },
      "specSection": "8",
      "minSpecVersion": "4.2"
    },
    {
      "name": "skips an over-indented line under a primitive list item in non-strict mode",
      "input": "items[2]:\n  - a\n    b: 1\n  - c",
      "expected": {
        "items": [
          "a",
          "c"
        ]
      },
      "options": {
        "strict": false
      },
      "specSection": "8",
      "minSpecVersion": "4.2"
    },
    {
      "name": "skips an over-indented line under a list-item field in non-strict mode",
      "input": "items[1]:\n  - a: 1\n      deep: 1\n    b: 2",
      "expected": {
        "items": [
          {
            "a": 1,
            "b": 2
          }
        ]
      },
      "options": {
        "strict": false
      },
      "specSection": "8",
      "minSpecVersion": "4.2"
    },
    {
      "name": "throws on a depth jump to the first tabular row",
      "input": "rows[1]{a}:\n    1",
      "expected": null,
      "shouldError": true,
      "specSection": "8"
    }
  ]
}
